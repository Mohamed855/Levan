APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Auction snapshot renderer (optional; defaults are resolved by Browsershot)
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_TIMEOUT=120

NEXT_VERSION_URL=
UPGRADE_SECRET=
UPGRADE_HMAC_MAX_AGE_SECONDS=300
UPGRADE_LEGACY_SECRET_UNTIL=2026-11-05T00:00:00+03:00
UPGRADE_API_RATE_LIMIT=5

MOYASAR_MODE=test
MOYASAR_TEST_PUBLISHABLE_KEY=
MOYASAR_TEST_SECRET_KEY=
MOYASAR_LIVE_PUBLISHABLE_KEY=
MOYASAR_LIVE_SECRET_KEY=
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
MOYASAR_API_TIMEOUT=15
MOYASAR_VERIFY_SSL=true

WHM_HOST=
WHM_API_URL=
WHM_TOKEN=
SERVER_IP=
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_URL=https://api.namecheap.com/xml.response
TICKET_API_BASE_URL=
TICKET_API_KEY=
TICKET_API_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
