<!-- Replaces the old jQuery WhatsApp script, the X injection script and the Facebook SDK -->
<script type="text/javascript">
    (function () {
        var IS_AR = /\/ar(\/|$)/i.test(window.location.pathname);
        var T = IS_AR
            ? { whatsapp: "مشاركة عبر واتساب", x: "مشاركة عبر منصة X", facebook: "مشاركة عبر فيسبوك", copy: "نسخ الرابط", copied: "تم نسخ الرابط", newWindow: "(يفتح في نافذة جديدة)" }
            : { whatsapp: "Share on WhatsApp", x: "Share on X", facebook: "Share on Facebook", copy: "Copy link", copied: "Link copied", newWindow: "(opens in a new window)" };

        function init() {
            // Share the page the visitor is on
            var pageUrl = window.location.origin + window.location.pathname;
            var pageTitle = (document.title || "").split(/[-|–]/)[0].trim();
            var u = encodeURIComponent(pageUrl);

            var links = {
                whatsapp: "https://api.whatsapp.com/send?text=" + encodeURIComponent(pageTitle + " " + pageUrl),
                x: "https://x.com/intent/post?text=" + encodeURIComponent(pageTitle) + "&url=" + u,
                facebook: "https://www.facebook.com/sharer/sharer.php?u=" + u
            };

            var bars = document.querySelectorAll(".share-bar");
            for (var b = 0; b < bars.length; b++) {
                var bar = bars[b];
                var status = bar.querySelector(".share-bar__status");
                var buttons = bar.querySelectorAll("[data-share]");

                for (var i = 0; i < buttons.length; i++) {
                    (function (btn) {
                        var kind = btn.getAttribute("data-share");
                        btn.setAttribute("title", T[kind]);

                        if (kind !== "copy") {
                            btn.setAttribute("href", links[kind]);
                            btn.setAttribute("aria-label", T[kind] + " " + T.newWindow);
                            return;
                        }

                        btn.setAttribute("aria-label", T.copy);
                        btn.addEventListener("click", function (e) {
                            e.preventDefault();
                            var done = function () {
                                btn.classList.add("is-copied");
                                if (status) status.textContent = T.copied;
                                setTimeout(function () {
                                    btn.classList.remove("is-copied");
                                    if (status) status.textContent = "";
                                }, 2000);
                            };
                            if (navigator.clipboard && window.isSecureContext) {
                                navigator.clipboard.writeText(pageUrl).then(done);
                            } else {
                                // http:// pages (e.g. the dev server) have no clipboard API
                                var tmp = document.createElement("textarea");
                                tmp.value = pageUrl;
                                tmp.style.position = "fixed";
                                tmp.style.opacity = "0";
                                document.body.appendChild(tmp);
                                tmp.select();
                                try { document.execCommand("copy"); done(); } catch (err) { }
                                document.body.removeChild(tmp);
                            }
                        });
                    })(buttons[i]);
                }
            }
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>
	</div>
</div>

<!-- ===================== Breadcrumb (Vue 3) ===================== -->
<script type="module">
  import { setupNajizVueApp } from "/_catalogs/masterpage/MOJPortalDesign2026/dist/ce/vue-app.js";

  const pageBreadcrumb = {
    name: "PageBreadcrumb",
    props: {
      items: { type: Array, default: () => [] },
      highlighted: { type: Boolean, default: false },
      ariaLabel: { type: String, default: "Breadcrumb" },
    },
    template: `
      <nav v-if="items.length" :aria-label="ariaLabel"
           :class="['breadcrumb n-position-relative n-z-index-1', { 'n-bg-primary-sa-flag-25': highlighted }]">
        <ol class="breadcrumb__list n-flex n-align-center n-gap-xs n-m-0 n-p-0">
          <template v-for="(item, index) in items" :key="\`\${item.text}-\${index}\`">
            <li v-if="index > 0" class="n-inline-flex n-align-center" aria-hidden="true">
              <n-icon name="arrow-right-01" size="16"></n-icon>
            </li>
            <li class="breadcrumb__item n-inline-flex n-align-center">
              <span v-if="item.disabled || index === items.length - 1"
                    class="breadcrumb__current n-color-neutral-500 n-text-sm" aria-current="page">
                {{ item.text }}
              </span>
              <a v-else :href="item.href"
                 class="breadcrumb__link n-color-neutral-700 hover:n-color-primary-sa-flag-600 n-text-sm n-text-decoration-none"
                 @click="onItemClick($event, item)">
                {{ item.text }}
              </a>
            </li>
          </template>
        </ol>
      </nav>
    `,
    methods: {
      onItemClick(event, item) {
        if (item.external || !item.href) return;
        event.preventDefault();
        window.dispatchEvent(new CustomEvent("najiz-breadcrumb-navigate", { detail: { item } }));
        window.location.href = item.href;
      },
    },
  };

  try {
    const app = await setupNajizVueApp({
      data() {
        const buildBreadcrumbs = () => {
          const spContext = window._spPageContextInfo || null;
          const origin = window.location.origin;
          const pathSegments = window.location.pathname.split('/').filter(Boolean);

          // English site lives under /english/ (also accepts /en/)
          const languageCodes = ['english', 'en', 'ar'];
          const homeLabels = { english: 'Home', en: 'Home', ar: 'الرئيسية' };
          const hiddenSegments = ['pages', 'sitepages'];

          // English display names for known folder segments
          const subsiteMap = {
            'ministry': 'Ministry',
            'about': 'About the Ministry',
            'services': 'Services',
            'eservices': 'E-Services',
            'mediacenter': 'Media Center',
            'departments': 'Departments'
            // Add any other folder names here (keys in lowercase)
          };

          const isHidden = (value) =>
            !!value && hiddenSegments.includes(value.trim().toLowerCase());

          const prettifySegment = (segment) =>
            decodeURIComponent(segment)
              .replace(/[-_]+/g, ' ')
              .replace(/\.[a-zA-Z]+$/, '')
              .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
              .split(' ')
              .filter(Boolean)
              .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
              .join(' ');

          const firstSegment = pathSegments[0] ? pathSegments[0].toLowerCase() : '';
          const langCode = languageCodes.includes(firstSegment) ? firstSegment : 'english';

          const crumbs = [{
            text: homeLabels[langCode] || homeLabels.english,
            href: `${origin}/${langCode}/pages/default.aspx`,
          }];

          let pathSoFar = '';
          const siteLevels = [];
          pathSegments.forEach((segment, index) => {
            pathSoFar += '/' + segment;
            if (index === 0 && languageCodes.includes(segment.toLowerCase())) return;
            if (isHidden(segment)) return;
            siteLevels.push({ segment, href: origin + pathSoFar });
          });

          siteLevels.forEach((level, index) => {
            const isLast = index === siteLevels.length - 1;
            const lowerSegment = level.segment.toLowerCase();
            let label;

            if (isLast) {
             label = document.title ? document.title.split(/\s+[-|–]\s+/)[0].trim() : prettifySegment(level.segment);           
              } else if (subsiteMap[lowerSegment]) {
              label = subsiteMap[lowerSegment];
            } else if (spContext && spContext.webTitle && spContext.webAbsoluteUrl &&
                       spContext.webAbsoluteUrl.toLowerCase().endsWith('/' + lowerSegment)) {
              label = spContext.webTitle.trim();
            } else {
              label = prettifySegment(level.segment);
            }

            if (isHidden(label)) return;

            crumbs.push({
              text: label,
              href: isLast ? undefined : level.href,
              disabled: isLast,
            });
          });

          return crumbs;
        };

        return { breadcrumbs: buildBreadcrumbs() };
      },
    });

    app.component("page-breadcrumb", pageBreadcrumb);
    app.mount("#page-breadcrumb-root");
  } catch (error) {
    console.error("[page-breadcrumb]", error);
    document.getElementById("page-breadcrumb-root").textContent = "Unable to load this section.";
  }
</script>

<script>
  ExecuteOrDelayUntilScriptLoaded(function () {
    var context = SP.ClientContext.get_current();
    var web = context.get_web();
    context.load(web);
    context.executeQueryAsync(
      function () { $('.text-1').text(web.get_title()); },
      function (sender, args) { console.error(args.get_message()); }
    );
  }, "SP.JS");
</script>

