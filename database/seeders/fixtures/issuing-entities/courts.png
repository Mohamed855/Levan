<script type="module">
  const base = "/_catalogs/masterpage/MOJPortalDesign2026/dist/ce/index-min.js";
  let mod;
  try {
    const res = await fetch(base + ".gz");
    if (!res.ok) throw new Error(res.status);
    const code = await new Response(
      res.body.pipeThrough(new DecompressionStream("gzip"))
    ).text();
    const blobUrl = URL.createObjectURL(new Blob([code], { type: "text/javascript" }));
    mod = await import(blobUrl);
    URL.revokeObjectURL(blobUrl);
  } catch (e) {
    // If anything fails, load the normal file instead
    mod = await import(base);
  }
  mod.registerAllComponents();
</script>




<!-- ===================== digital-stamp (standalone web part) ===================== -->
<div id="digital-stamp-root"></div>

<template id="digital-stamp-tpl">
  <section :dir="isAr ? 'rtl' : 'ltr'" :lang="isAr ? 'ar' : 'en'" class="digital-stamp n-position-relative n-bg-neutral-100 n-color-neutral-950">
    <div class="digital-stamp__inner n-mx-auto n-py-xs n-flex-wrap n-flex n-align-center n-justify-between n-gap-xl">
      <div class="digital-stamp__identity n-min-width-0 n-flex-wrap n-flex n-align-center n-gap-sm">
        <img
          class="digital-stamp__flag"
          :src="flagIcon"
          :alt="t.flagAlt"
          width="20"
          height="14"
        />
        <n-typography
          as="span"
          variant="text-sm"
          class="digital-stamp__message n-color-neutral-700 n-font-weight-medium"
        >
          {{ t.message }}
        </n-typography>

        <!-- type="button" is required: SharePoint wraps the page in a <form>,
             so a button without it submits the page (postback) instead of toggling. -->
        <a
          href="#digital-stamp-verification"
          role="button"
          class="digital-stamp__verify n-inline-flex n-color-primary-sa-flag-600 n-font-weight-regular"
          color="primary"
          variant="subtle"
          size="md"
          :append-icon="isVerificationOpen ? 'arrow-up-01' : 'arrow-down-01'"
          :aria-expanded="String(isVerificationOpen)"
          aria-controls="digital-stamp-verification"
          @click.prevent="toggleVerification"
        >
          {{ t.howToVerify }} 
        </a>
      </div>

      <div
        class="digital-stamp__tools n-flex n-align-center n-gap-none"
        role="group"
        :aria-label="t.tools"
      >
        <!-- Display settings (the only place on the page; normal / dark / gray / brightness).
             A native <button> (the click on <n-btn> did not reach Vue), and the menu is
             teleported to <body> with fixed positioning so no SharePoint zone can clip it. -->
        <button
          ref="visionBtn"
          type="button"
          class="digital-stamp__tool digital-stamp__tool--native"
          :class="{ 'is-active': isVisionOpen || visionMode !== 1 }"
          aria-haspopup="true"
          :aria-expanded="String(isVisionOpen)"
          aria-controls="ds-vision-menu"
          :aria-label="t.displaySettings"
          :title="t.displaySettings"
          @click.prevent.stop="toggleVision"
        >
          <i class="n-icon hgi-stroke hgi-view n-color-inherit n-icon-size-20" aria-hidden="true"></i>
        </button>

        <Teleport to="body">
          <fieldset
            v-show="isVisionOpen"
            id="ds-vision-menu"
            ref="visionMenu"
            class="ds-vision"
            :dir="isAr ? 'rtl' : 'ltr'"
            :lang="isAr ? 'ar' : 'en'"
            :style="visionStyle"
            @click.stop
          >
            <legend class="ds-vision__title">{{ t.displaySettings }}</legend>
            <label
              v-for="mode in visionModes"
              :key="mode.value"
              class="ds-vision__option"
              :for="'ds-vision-' + mode.value"
            >
              <input
                :id="'ds-vision-' + mode.value"
                type="radio"
                name="ds-vision-mode"
                :value="mode.value"
                v-model="visionMode"
              />
              <span>{{ mode.label }}</span>
            </label>
          </fieldset>
        </Teleport>
        <n-btn
          type="button"
          class="digital-stamp__tool n-inline-flex n-p-sm n-color-neutral-700"
          variant="transparent"
          size="sm"
          prepend-icon="zoom-out-area"
          :aria-label="t.zoomOut"
          :title="t.zoomOut"
          :disabled="textScale <= MIN_SCALE"
          @click.prevent="changeScale(-1)"
        ></n-btn>
        <n-btn
          type="button"
          class="digital-stamp__tool n-inline-flex n-p-sm n-color-neutral-700"
          variant="transparent"
          size="sm"
          prepend-icon="zoom-in-area"
          :aria-label="t.zoomIn"
          :title="t.zoomIn"
          :disabled="textScale >= MAX_SCALE"
          @click.prevent="changeScale(1)"
        ></n-btn>
        <n-btn
          type="button"
          class="digital-stamp__tool n-inline-flex n-p-sm n-color-neutral-700"
          variant="transparent"
          size="sm"
          prepend-icon="sign-language-c"
          :aria-label="t.signLanguage"
          :title="t.signLanguage"
          @click.prevent="openSignLanguage"
        ></n-btn>
      </div>
    </div>

    <!-- The accordion panel (was missing: aria-controls pointed at an element that didn't exist) -->
    <div
      v-show="isVerificationOpen"
      id="digital-stamp-verification"
      class="digital-stamp__panel"
      role="region"
      :aria-label="t.panelLabel"
    >
      <div class="digital-stamp__panel-inner n-mx-auto n-flex n-flex-wrap n-gap-xl n-py-lg">
        <div class="digital-stamp__point n-flex n-gap-sm">
          <i class="n-icon hgi-stroke hgi-link-circle n-icon-size-24 n-color-primary-sa-flag-600" aria-hidden="true"></i>
          <div>
            <strong class="n-block n-text-sm">{{ t.govTitle }}</strong>
            <span class="n-text-sm n-color-neutral-700">
              {{ t.govText }}
            </span>
          </div>
        </div>
        <div class="digital-stamp__point n-flex n-gap-sm">
          <i class="n-icon hgi-stroke hgi-square-lock-02 n-icon-size-24 n-color-primary-sa-flag-600" aria-hidden="true"></i>
          <div>
            <strong class="n-block n-text-sm">{{ t.httpsTitle }}</strong>
            <span class="n-text-sm n-color-neutral-700">
              {{ t.httpsText }}
            </span>
          </div>
        </div>
      </div>

      <!-- Third row: DGA registration -->
      <div class="digital-stamp__panel-inner digital-stamp__registration n-mx-auto n-flex n-flex-wrap n-align-center n-gap-sm n-py-lg">
        <img
          class="digital-stamp__dga-logo"
          :alt="t.dgaAlt"
          src="https://najizcdn.moj.gov.sa/shared/V3/images/dist/svg/dga-logo.svg?v=50b8c4eb-de5d-434f-8ce9-c121dc95189c"
          height="40"
        />
        <span class="digital-stamp__reg-label n-text-sm n-color-neutral-700">{{ registeredLabel }}</span>
        <a
          class="digital-stamp__reg-link n-text-sm n-font-weight-medium"
          :href="DGA_LICENSE_URL"
          target="_blank"
          rel="noopener noreferrer"
          dir="ltr"
        >{{ DGA_REG_NUMBER }}</a>
      </div>
    </div>
  </section>
</template>



<script type="module">
