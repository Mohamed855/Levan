<!-- ===================== site-footer (standalone web part) ===================== -->
<!-- Mount point: stays empty in the HTML; Vue renders the footer into it.
     The markup lives in the x-template below so the HTML validator never sees the Vue
     attributes (:href, @click, v-for ...). The ASP.NET server tags inside it still run as before. -->
<div id="site-footer-root"></div>

<script type="text/x-template" id="site-footer-tpl">
  <footer
    class="site-footer n-bg-neutral-100 n-color-neutral-800"
    aria-labelledby="footer-title"
  >
    <n-typography
      id="footer-title"
      as="h2"
      variant="text-lg"
      class="site-footer__sr-only n-sr-only"
    >
      {{ t.footerTitle }}
    </n-typography>

    <div class="site-footer__inner n-mx-auto n-pt-5xl n-pb-3xl">
      <div class="site-footer__columns">
        <section
          v-for="group in linkGroups"
          :key="group.title"
          class="site-footer__column"
        >
          <n-typography
            as="h3"
            variant="text-md"
            class="site-footer__title n-color-neutral-900 n-font-weight-medium"
          >
            {{ group.title }}
          </n-typography>

          <ul class="site-footer__links n-m-0 n-p-0 n-flex n-flex-column">
            <li v-for="link in group.links" :key="link.title">
              <a :href="link.url" @click.prevent="openFooterLink(link)">
                {{ link.title }}
                <i v-if="isExternal(link)" class="n-icon hgi-stroke hgi-link-square-01 n-color-inherit n-icon-size-16 site-footer__external-icon" aria-hidden="true"></i>
                <span v-if="isExternal(link)" class="n-sr-only">{{ t.newWindow }}</span>
              </a>
            </li>
          </ul>
        </section>

        <section class="site-footer__column site-footer__social-column">
         		  
		  <n-typography
            as="h3"
            variant="text-md"
            class="site-footer__title n-color-neutral-900 n-font-weight-medium"
          >
            MOJ on Social Media
          </n-typography>
          <ul
            class="site-footer__icon-list n-m-0 n-p-0"
            :aria-label="t.socialLabel"
          >
            <li v-for="social in socials" :key="social.icon">
              <a
                :href="social.url"
                target="_blank"
                rel="noopener noreferrer"
                class="site-footer__icon-btn"
                :aria-label="social.name + ' ' + t.newWindow"
                :title="social.name"
                @click="openSocial(social)"
              >
                <i :class="'n-icon hgi-stroke hgi-' + social.icon + ' n-color-inherit n-icon-size-20'" aria-hidden="true"></i>
              </a>
            </li>
          </ul>

          <n-typography
            as="h3"
            variant="text-md"
            class="site-footer__title site-footer__tools-title n-color-neutral-900 n-font-weight-medium"
          >
            Accessibility Tools
          </n-typography>
          <!-- Same set as the Najiz landing footer: text size -/+, sign language, live chat.
               type="button" matters: SharePoint wraps the page in a <form>. -->
          <ul
            class="site-footer__icon-list n-m-0 n-p-0"
            :aria-label="t.toolsLabel"
          >
            <li>
              <button
                type="button"
                class="site-footer__icon-btn"
                :aria-label="t.zoomOut"
                :title="t.zoomOut"
                :disabled="textScale <= MIN_SCALE"
                @click.prevent="changeScale(-1)"
              >
                <i class="n-icon hgi-stroke hgi-zoom-out-area n-color-inherit n-icon-size-20" aria-hidden="true"></i>
              </button>
            </li>
            <li>
              <button
                type="button"
                class="site-footer__icon-btn"
                :aria-label="t.zoomIn"
                :title="t.zoomIn"
                :disabled="textScale >= MAX_SCALE"
                @click.prevent="changeScale(1)"
              >
                <i class="n-icon hgi-stroke hgi-zoom-in-area n-color-inherit n-icon-size-20" aria-hidden="true"></i>
              </button>
            </li>
            <li>
              <a
                href='https://najiz.sa/applications/video-chat'
                target="_blank"
                rel="noopener noreferrer"
                class="site-footer__icon-btn site-footer__icon-btn--label"
                title='Technical Support in Sign Language'
                aria-label='Technical Support in Sign Language'
              >
                <i class="n-icon hgi-stroke hgi-sign-language-c n-color-inherit n-icon-size-20" aria-hidden="true"></i>
                <span>Technical Support in Sign Language</span>
              </a>
            </li>
            <li>
              <a
                href='https://najiz.sa/applications/landing'
                target="_blank"
                rel="noopener noreferrer"
                class="site-footer__icon-btn"
                title='Live Chat'
                aria-label='Live Chat'
              >
                <i class="n-icon hgi-stroke hgi-bubble-chat n-color-inherit n-icon-size-20" aria-hidden="true"></i>
              </a>
            </li>
          </ul>

        </section>
		  
			
        <section class="site-footer__column site-footer__app-column">
          <n-typography
            as="h3"
            variant="text-md"
            class="site-footer__title n-color-neutral-900 n-font-weight-medium"
          >
            Najiz App
          </n-typography>
          <div class="app-stores">
                    <a href="https://apps.apple.com/ca/app/najiz-%D9%86%D8%A7%D8%AC%D8%B2/id1524792474" target="_blank" rel="noopener noreferrer">
                        <span class="n-sr-only">Download Najiz Apps</span>
                        <img alt="Download Najiz Apps" class="app-store-icon" src="https://najizcdn.moj.gov.sa/shared/V3/images/dist/svg/app-store.svg?v=3d944a9b-5159-4b08-bd75-675a3345f88b">
                    </a>

                    <a href="https://play.google.com/store/apps/details?id=com.moj.najiz&amp;hl=ar&amp;gl=US" target="_blank" rel="noopener noreferrer">
                        <span class="n-sr-only">Download Najiz Apps</span>
                        <img alt="Download Najiz Apps" class="app-store-icon" src="https://najizcdn.moj.gov.sa/shared/V3/images/dist/svg/google-play.svg?v=f5638328-37ad-45f1-8f77-66987cc22549">
                    </a>
                </div>
        </section>
      </div>

      <n-divider
        class="site-footer__divider n-block n-mt-4xl n-mb-3xl"
      ></n-divider>

      <div
        class="site-footer__bottom n-flex n-align-center n-justify-between n-gap-4xl"
      >
	  

			
			
        <div class="site-footer__legal">
          <nav
            class="site-footer__legal-links n-flex n-flex-wrap n-mb-lg"
            :aria-label="t.legalLabel"
          >
            <a
              v-for="link in legalLinks"
              :key="link.title"
              :href="link.url"
              @click.prevent="openFooterLink(link)"
            >
              {{ link.title }}
            </a>
          </nav>
          <n-typography
            as="p"
            variant="text-sm"
            class="site-footer__copyright n-m-0 n-color-neutral-600 n-font-weight-semibold"
          >
             Copyright © Ministry of Justice  {{ currentYear }}
          </n-typography>
         
        </div>
		
		<div class="re-edited-box-icon"> 
		<!-- W3C badge: same card look as the footer icon buttons -->
		<a
		  class="w3c-badge"
		  href="https://jigsaw.w3.org/css-validator/validator?uri=https%3A%2F%2Fwww.moj.gov.sa%2Fenglish%2Fpages%2Fdefault.aspx"
		  target="_blank"
		  rel="noopener noreferrer"
		  :aria-label="t.w3cLabel + ' ' + t.newWindow"
		  :title="t.w3cLabel"
		>
		  <span class="w3c-badge__text">
		    <span class="w3c-badge__title">{{ t.w3cTitle }}</span>
		    <span class="w3c-badge__sub">{{ t.w3cSub }}</span>
		  </span>
		  <span class="w3c-badge__check" aria-hidden="true">
		    <i class="n-icon hgi-stroke hgi-checkmark-circle-02 n-color-inherit n-icon-size-20"></i>
		  </span>
		</a>
		  
		</div>
		<div class="sealing">
		
		<!-- Vision 2030 logo (same as the header's) -->
		<a
		  class="site-footer__vision-link n-inline-flex n-align-center"
		  :href="t.visionUrl"
		  target="_blank"
		  rel="noopener noreferrer"
		  :aria-label="t.visionAlt + ' ' + t.newWindow"
		>
		  <img
		    class="site-footer__vision-logo"
		    :src="visionLogoUrl"
		    :alt="t.visionAlt"
		    width="111"
		    height="75"
		  />
		</a>
      </div>
    </div>
    </div><!-- /.site-footer__inner (this closing tag was missing) -->
  </footer>
</script>



<!-- Najiz-style footer CSS. Kept in a data block and added to <head> by the script below,
     because a <style> element inside <body> fails the HTML validator. -->
<script type="text/plain" id="site-footer-css">
  /* Five equal columns, as in the Najiz footer */
  #site-footer-root .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px 16px;
    align-items: start;
  }

  #site-footer-root .site-footer__column {
    min-inline-size: 0;
  }

  /* Column heading with a full-width line under it */
  #site-footer-root .site-footer__title {
    display: block;
    margin-block: 0 10px;
    padding-block-end: 10px;
    border-block-end: 1px solid #d2d6db;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* One line per heading: only the outer heading element draws it */
  #site-footer-root .site-footer__title * {
    margin: 0;
    padding: 0;
    border: 0;
  }

  #site-footer-root .site-footer__title::before,
  #site-footer-root .site-footer__title::after,
  #site-footer-root .site-footer__title *::before,
  #site-footer-root .site-footer__title *::after {
    content: none;
  }

  #site-footer-root .site-footer__tools-title {
    margin-block-start: 32px;
  }

  /* Links: sizes are in rem so the text-size buttons keep working */
  #site-footer-root .site-footer__links {
    gap: 12px;
    list-style: none;
  }

  #site-footer-root .site-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    line-height: 1.43;
    color: #4d5761;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #site-footer-root .site-footer__links a:hover {
    color: #1b8354;
    text-decoration: underline;
  }

  #site-footer-root .site-footer__links a:focus-visible,
  #site-footer-root .site-footer__icon-btn:focus-visible {
    outline: 2px solid #1b8354;
    outline-offset: 2px;
  }

  #site-footer-root .site-footer__external-icon {
    flex: 0 0 auto;
    color: #6c737f;
  }

  #site-footer-root .site-footer__icon-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  /* The resets matter: SharePoint's corev15.css gives every <button> a white background,
     a minimum width and a side margin. */
  #site-footer-root .site-footer__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    inline-size: 36px;
    min-inline-size: 0;
    block-size: 36px;
    margin: 0;
    padding: 0;
    font-family: inherit;
    color: #1f2a37;
    text-decoration: none;
    cursor: pointer;
    background: transparent;
    border: 1px solid #d2d6db;
    border-radius: 6px;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  #site-footer-root .site-footer__icon-btn:hover {
    color: #1f2a37;
    background: #e5e7eb;
    border-color: #9da4ae;
  }

  #site-footer-root .site-footer__icon-btn:disabled,
  #site-footer-root .site-footer__icon-btn:disabled:hover {
    cursor: not-allowed;
    background: transparent;
    border-color: #d2d6db;
    opacity: 0.45;
  }

  #site-footer-root .site-footer__icon-btn--label {
    inline-size: auto;
    padding-inline: 12px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.43;
    white-space: nowrap;
  }

  /* App column: heading centered; badges at the end of the row (left in Arabic, right in English) */
  #site-footer-root .site-footer__app-column .site-footer__title {
    display: flex;
    justify-content: center;
    text-align: center;
  }

  #site-footer-root .app-stores {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    inline-size: 100%;
    gap: 8px;
  }

  #site-footer-root .app-stores a {
    display: block;
  }

  #site-footer-root .app-store-icon {
    display: block;
    inline-size: 120px;
    block-size: auto;
  }

  @media (max-width: 1199px) {
    #site-footer-root .site-footer__columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    #site-footer-root .site-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 479px) {
    #site-footer-root .site-footer__columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</script>

<script type="module">
 
      import { setupNajizVueApp } from "/_catalogs/masterpage/MOJPortalDesign2026/dist/ce/vue-app.js";
	 const homeUrl = window.location.origin + '/English';
  const IS_AR = /\/ar(\/|$)/i.test(window.location.pathname);

  const T = IS_AR
    ? {
        socialLabel: "حسابات التواصل الاجتماعي",
        w3cTitle: "W3C CSS",
        w3cSub: "متوافق مع المعايير",
        w3cLabel: "التحقق من توافق الموقع مع معايير W3C",
        toolsLabel: "أدوات تسهيل الوصول",
        zoomOut: "تصغير حجم النص",
        zoomIn: "تكبير حجم النص",
        newWindow: "(يفتح في نافذة جديدة)",
        visionUrl: "https://www.vision2030.gov.sa/ar/",
        visionAlt: "رؤية المملكة 2030",
        footerTitle: "تذييل موقع وزارة العدل",
        legalLabel: "الروابط القانونية",
        loadError: "تعذر تحميل هذا القسم",
      }
    : {
        socialLabel: "MOJ social media accounts",
        w3cTitle: "W3C CSS",
        w3cSub: "Standards compliant",
        w3cLabel: "Check the site's W3C standards compliance",
        toolsLabel: "Accessibility tools",
        zoomOut: "Decrease text size",
        zoomIn: "Increase text size",
        newWindow: "(opens in a new window)",
        visionUrl: "https://www.vision2030.gov.sa/en",
        visionAlt: "Saudi Vision 2030",
        footerTitle: "Ministry of Justice website footer",
        legalLabel: "Legal links",
        loadError: "This section could not be loaded",
      };

  /* Text size: same storage and steps as the digital stamp, so both stay in sync */
  const MIN_SCALE = -2;
  const MAX_SCALE = 3;
  const SCALE_STEP = 0.0625;
  const A11Y_KEY = "moj.a11y";
  function readScale() {
    try {
      const v = (JSON.parse(localStorage.getItem(A11Y_KEY)) || {}).textScale;
      return Number.isInteger(v) ? v : 0;
    } catch {
      return 0;
    }
  }
    
	  

  try {
    const footerStyle = document.createElement("style");
    footerStyle.textContent = document.getElementById("site-footer-css").textContent;
    document.head.appendChild(footerStyle);

    const app = await setupNajizVueApp({
      // Read the template from the x-template above (textContent = the raw, unparsed markup)
      template: document.getElementById("site-footer-tpl").textContent,
      data() {
        return {
          currentYear: new Date().getFullYear(),
          t: T,
          MIN_SCALE,
          MAX_SCALE,
          textScale: readScale(),
          highContrast: false,
          // Absolute path (an inline module's import.meta.url is the page URL)
          visionLogoUrl: "/_catalogs/masterpage/MOJPortalDesign2023/images/vision2030.svg",
          linkGroups: [
            {
              title: 'About MOJ Portal',
              links: [
				{ title: 'About Us', url: '/ar/Ministry/Pages/AboutUs.aspx' },
                { title: 'Information Security Strategy', url: '/English/Ministry/Pages/informationSecurityStrategy.aspx' },
                { title: 'News', url: '/english/MediaCenter/News/Pages/default.aspx' },
                { title: 'Subscribe to the newsletter', url: 'https://www.moj.gov.sa/english/Ministry/Pages/Newsletters.aspx' },
                { title:'Service Level Agreement', url: '/English/Ministry/Pages/sla.aspx' },
				{ title:'Accessibility', url: '/english/Ministry/Pages/Accessibility.aspx' },
              ],
            },
            {
			
			
			
              title: 'Contact Us',
              links: [
                { title: 'e-Participation\r\n  ', url: '/english/Ministry/eParticipation/Pages/default.aspx\r\n  ' },
				{ title: 'Complaint', url: 'https://najiz.sa/applications/crm/create' },
				{ title: 'Nazaha', url: 'https://my.gov.sa/en/content/report-corruption' },
				{ title: 'Rights to Information', url: '/English/Ministry/Pages/Info-Rights.aspx' },
				{ title: 'FAQ', url: '/English/Ministry/Pages/FAQ.aspx' },
				
              ],
            },
			
		
			
            {
              title: 'Important Links',
              links: [
               { title: 'Supreme Judicial Council', url: 'https://www.scj.gov.sa/' },
				{ title: 'National Portal\r\n  ', url: 'https://my.gov.sa/en\r\n  ' },
				{ title: 'Saudi Open Data portal \r\n\r\n  ', url: 'https://od.data.gov.sa/en\r\n\r\n  ' },
				{ title: 'e-Participation Portal\r\n  ', url: 'https://eparticipation.my.gov.sa/\r\n  ' },
				{ title: 'Public consultation platform (Istitlaa (\r\n\r\n  ', url: 'https://istitlaa.ncc.gov.sa/ar/Pages/default.aspx\r\n\r\n\r\n  ' },
				{ title: 'Saudi Press Agency', url: 'https://www.spa.gov.sa/en' },
				{ title: 'Um Alqura NewsPaper', url: 'https://www.uqn.gov.sa/' },
				{ title: 'Bureau of Experts of Council of Ministers', url: 'https://www.boe.gov.sa/en/Pages/default.aspx' },
				{ title: 'Saudi Bar Association', url: 'https://sba.gov.sa/' },
				{ title: 'Nafaqah Fund', url: 'https://nafaqah.sa/' },
				{ title: 'Taradhi Platform', url: 'https://taradhi.moj.gov.sa/' },
				{ title: 'Najiz Center', url: 'https://najizsa.com/' },
				{ title: 'Judicial Training Center', url: 'https://tms-jtc.moj.gov.sa/' },
              ],
            },
          ],
           socials: [
            { name: IS_AR ? "إكس" : "X", icon: "new-twitter", url: 'https://x.com/mojksa_en' },
            { name: IS_AR ? "فيسبوك" : "Facebook", icon: "facebook-01", url: 'https://www.facebook.com/MojKsaEn/' },
            { name: IS_AR ? "يوتيوب" : "YouTube", icon: "youtube", url: "https://youtube.com/MOJKSA" },
            { name: IS_AR ? "سناب شات" : "Snapchat", icon: "snapchat", url: "https://snapchat.com/add/MOJKSA" },
            { name: IS_AR ? "إنستغرام" : "Instagram", icon: "instagram", url: "https://instagram.com/MOJKSA" },
            { name: IS_AR ? "لينكد إن" : "LinkedIn", icon: "linkedin-01", url: "https://linkedin.com/company/MOJKSA" },
          ],
          legalLinks: [
           { title: 'Privacy Policy', url: '/english/Ministry/Pages/PrivacyPolicy.aspx' },
		   { title: 'Terms Of Use', url: '/english/Ministry/Pages/TermsofUse.aspx' },
		   { title: 'Site Map', url: '/English/Pages/SiteMap.aspx' },
          ],
        };
      },
      mounted() {
        this.applyScale();
      },
      methods: {
        changeScale(direction) {
          this.textScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, this.textScale + direction));
          this.applyScale();
        },
        applyScale() {
          document.documentElement.style.fontSize =
            this.textScale === 0 ? "" : `${100 + this.textScale * SCALE_STEP * 100}%`;
          try {
            localStorage.setItem(A11Y_KEY, JSON.stringify({ textScale: this.textScale }));
          } catch {
            /* storage unavailable – applies for this page view only */
          }
        },
        toggleContrast() {
          this.highContrast = !this.highContrast;
          document.documentElement.classList.toggle("page-high-contrast", this.highContrast);
        },
		 isExternal(link) {
			return Boolean(link.external) || /^https?:\/\//i.test(link.url || "");
		 },
		 openFooterLink(link) {
			if (!link.url) return;

			window.dispatchEvent(new CustomEvent("najiz-footer-link-open", { detail: { link } }));

			// روابط خارجية (http/https خارج نطاق الموقع) تُفتح في تبويب جديد،
			// وروابط الموقع الداخلية تُفتح في نفس الصفحة
			if (this.isExternal(link)) {
			  window.open(link.url, "_blank", "noopener,noreferrer");
			} else {
			  window.location.href = link.url;
			}
		  },
        openSocial(social) {
          window.dispatchEvent(new CustomEvent("najiz-social-open", { detail: { social } }));
        },
        openStore(store) {
          window.dispatchEvent(new CustomEvent("najiz-store-open", { detail: { store } }));
        },
      },
    });

    app.mount("#site-footer-root");
  } catch (error) {
    console.error("[site-footer]", error);
    document.getElementById("site-footer-root").textContent = T.loadError;
  }
</script>
     
<script type="text/javascript">
 
   
    
$(function () {
    
		var input = document.getElementById("txtSearchValue");
			// Execute a function when the user presses a key on the keyboard
		input.addEventListener("keypress", function(event) {
		  // If the user presses the "Enter" key on the keyboard
		  if (event.key === "Enter") {
			// Cancel the default action, if needed
			event.preventDefault();
			// Trigger the button element with a click
			document.getElementById("submitForm").click();
		  }
		});


     $('#submitForm').on('click', function(event) {
    
         			   event.preventDefault();
                       var queryString = encodeURIComponent($('#txtSearchValue').val());
                       
                       
                      var searchTxtBox = document.getElementById("txtSearchValue");
					  var autoCompletInputEvent = new Event('change');
					  searchTxtBox.dispatchEvent(autoCompletInputEvent);

					  sessionStorage.setItem("searchVal", queryString );
                       var location = "/english/search/Pages/SearchResults.aspx?sw=" + queryString ;
                       //$('#search-input').attr("value", '');
                       window.location.href = location;
					   $('#txtSearchPageValue').val(queryString);
 						$('#Sites').val('https://www.moj.gov.sa/Lists/eservicesListNew/');

                       return;
    })
    
	 $('#submitFormAdvanced').on('click', function(event) {
    
         			   event.preventDefault();
                       var queryString = encodeURIComponent($('#txtSearchValue').val());
                       

					   sessionStorage.setItem("searchVal", queryString );
                       var location = "/english/search/Pages/SearchResults.aspx?sw=" + queryString ;
                       $('#search-input').attr("value", '');
                       window.location.href = location;
					  $('#txtSearchPageValue').val(queryString);
						$('#Sites').val('https://www.moj.gov.sa/Lists/eservicesListNew/');
                       return;
    })
    });
    
   




</script> 

   

  


 
 



