      httpsText: "Secure websites in Saudi Arabia use the HTTPS protocol for encryption.",
      dgaAlt: "Digital Government Authority",
      registeredWith: "Registered with the Digital Government Authority under number:",
      loadError: "This section could not be loaded",
    },
  };
  const T = IS_AR ? LABELS.ar : LABELS.en;

  /* DGA registration (third row of the verification panel) */
  const DGA_REG_NUMBER = "20260609252";
  const DGA_LICENSE_URL =
    "https://raqmi.dga.gov.sa/platforms/platforms/98887777-b59d-443c-ab16-8222cf955bb5/platform-license";

  /* ---------- Display modes (the digital stamp is the only place they are set) ---------- */
  const VISION_STORAGE_KEY = "moj.visionMode";
  const VISION_CLASSES = { 2: "vision-dark", 3: "vision-gray", 4: "vision-bright" };

  function readStoredVision() {
    try {
      const v = Number(localStorage.getItem(VISION_STORAGE_KEY));
      return [1, 2, 3, 4].includes(v) ? v : 1;
    } catch {
      return 1;
    }
  }

  const MIN_SCALE = -2;
  const MAX_SCALE = 3;
  const SCALE_STEP = 0.0625; // 1/16 of the base size per step
  const STORAGE_KEY = "moj.a11y";
  const SIGN_LANGUAGE_URL = "https://najiz.sa/applications/video-chat";

  function readPrefs() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
    } catch {
      return {};
    }
  }

  try {
    const prefs = readPrefs();
    const app = await setupNajizVueApp({
      template: document.getElementById("digital-stamp-tpl").innerHTML,
      data() {
        return {
          isAr: IS_AR,
          t: T,
          DGA_REG_NUMBER,
          DGA_LICENSE_URL,
          MIN_SCALE,
          MAX_SCALE,
          isVerificationOpen: false,
          textScale: Number.isInteger(prefs.textScale) ? prefs.textScale : 0,
          isVisionOpen: false,
          visionStyle: {},
          visionMode: readStoredVision(),
          visionModes: [
            { value: 1, key: "normal", label: T.normal },
            { value: 2, key: "dark", label: T.dark },
            { value: 3, key: "gray", label: T.gray },
            { value: 4, key: "bright", label: T.bright },
          ],
          // Absolute path: an inline module's import.meta.url is the *page* URL,
          // so "../assets/..." resolved relative to the SharePoint page, not the dist folder.
          flagIcon: "/_catalogs/masterpage/MOJPortalDesign2026/assets/saudi-flag-mark.svg",
        };
      },
      computed: {
        // Falls back to the built-in text if the LABELS key is missing in a merged copy.
        registeredLabel() {
          return (
            this.t.registeredWith ||
            (this.isAr
              ? "مسجل لدى هيئة الحكومة الرقمية برقم:"
              : "Registered with the Digital Government Authority under number:")
          );
        },
      },
      watch: {
        visionMode(mode) {
          this.applyVision(mode);
        },
      },
      mounted() {
        this.applyPrefs();
        this.applyVision(this.visionMode);
        document.addEventListener("click", this.onDocumentClick);
        document.addEventListener("keydown", this.onKeydown);
        window.addEventListener("resize", this.positionVision);
        window.addEventListener("scroll", this.positionVision, true);
      },
      beforeUnmount() {
        document.removeEventListener("click", this.onDocumentClick);
        document.removeEventListener("keydown", this.onKeydown);
        window.removeEventListener("resize", this.positionVision);
        window.removeEventListener("scroll", this.positionVision, true);
      },
      // These methods were missing, so every @click did nothing.
      methods: {
        toggleVerification() {
          this.isVerificationOpen = !this.isVerificationOpen;
        },
        toggleVision() {
          this.isVisionOpen = !this.isVisionOpen;
          if (this.isVisionOpen) {
            this.$nextTick(() => {
              this.positionVision();
              // move focus to the selected option for keyboard users
              document.getElementById("ds-vision-" + this.visionMode)?.focus();
            });
          }
        },
        /* Place the menu right under the button, kept inside the window.
           Arabic: menu starts at the button's left edge; English: ends at its right edge. */
        positionVision() {
          if (!this.isVisionOpen) return;
          const btn = this.$refs.visionBtn;
          const menu = this.$refs.visionMenu;
          if (!btn || !menu) return;
          const r = btn.getBoundingClientRect();
          const w = menu.offsetWidth || 192;
          const gap = 6;
          let left = this.isAr ? r.left : r.right - w;
          left = Math.max(8, Math.min(left, window.innerWidth - w - 8));
          this.visionStyle = { top: `${Math.round(r.bottom + gap)}px`, left: `${Math.round(left)}px` };
        },
        closeVision(returnFocus = false) {
          if (!this.isVisionOpen) return;
          this.isVisionOpen = false;
          if (returnFocus) this.$refs.visionBtn?.focus();
        },
        onDocumentClick() {
          this.closeVision();
        },
        onKeydown(event) {
          if (event.key === "Escape") this.closeVision(true);
        },
        applyVision(mode) {
          const root = document.documentElement;
          Object.values(VISION_CLASSES).forEach((c) => root.classList.remove(c));
          if (VISION_CLASSES[mode]) root.classList.add(VISION_CLASSES[mode]);
          try {
            localStorage.setItem(VISION_STORAGE_KEY, String(mode));
          } catch {
            /* storage unavailable – mode still applies for this page view */
          }
        },
        changeScale(delta) {
          this.textScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, this.textScale + delta));
          this.applyPrefs();
        },
        openSignLanguage() {
          window.open(SIGN_LANGUAGE_URL, "_blank", "noopener");
        },
        applyPrefs() {
          const root = document.documentElement;
          root.classList.remove("ds-high-contrast"); // old contrast toggle, replaced by the display modes
          root.style.fontSize = this.textScale === 0 ? "" : `${100 + this.textScale * SCALE_STEP * 100}%`;
          try {
            localStorage.setItem(
              STORAGE_KEY,
              JSON.stringify({ textScale: this.textScale }),
            );
          } catch {
            /* storage unavailable – settings apply for this page view only */
          }
        },
      },
    });

    app.mount("#digital-stamp-root");
  } catch (error) {
    console.error("[digital-stamp]", error);
    document.getElementById("digital-stamp-root").textContent = T.loadError;
  }
</script>

<!-- ===================== nav-header v2 (standalone web part, Vue-driven) ===================== -->
<!-- Mount point: stays empty in the HTML; Vue renders the header into it.
     The markup lives in the x-template below so the HTML validator never sees the Vue
     attributes (:href, @click, v-for ...). A script with a non-JS type is plain text to the
     browser and the validator, and Vue reads it as the template. -->
<div id="nav-header-root"></div>

<script type="text/x-template" id="nav-header-tpl">
  <header
    class="nav-header n-position-relative n-color-neutral-800"
    :class="{ 'nav-header--menu-open': isMobileMenuOpen }"
  >
    <div class="nav-header__inner n-flex n-align-center">
      <!-- Brand: ministry logo (home). The Vision 2030 logo is in the footer. -->
      <div class="nav-header__brand n-inline-flex n-align-center">
        <a class="nav-header__logo-link n-inline-flex n-align-center" :href="t.homeUrl">
          <img
            class="nav-header__logo"
            :src="logoUrl"
            :alt="t.logoAlt"
            width="85"
            height="95"
          />
        </a>
      </div>

      <!-- Mobile toggle -->
      <button
        type="button"
        class="nav-header__mobile-toggle n-cursor-pointer n-radius-md"
        :aria-expanded="String(isMobileMenuOpen)"
        aria-controls="primary-navigation"
        :aria-label="isMobileMenuOpen ? t.closeMenu : t.openMenu"
        @click.stop="toggleMobileMenu"
      >
        <span></span><span></span><span></span>
      </button>

      <!-- Primary navigation -->
      <nav id="primary-navigation" class="nav-header__navigation n-align-stretch" :aria-label="t.mainNav">
        <ul class="nav-header__menu n-align-stretch n-m-0 n-p-0">
          <li
            v-for="(item, i) in menuItems"
            :key="item.title || i"
            class="nav-header__menu-item n-position-relative n-align-stretch"
            :class="{ 'is-current': activeTop === i }"
          >
            <button
              v-if="item.children"
              type="button"
              class="nav-header__menu-link nav-header__menu-link--button n-inline-flex n-align-center n-gap-xs n-color-neutral-800 n-text-md n-font-weight-medium n-text-decoration-none n-cursor-pointer"
              :class="{ 'is-current': activeTop === i }"
              :aria-expanded="String(openMenu === item.title)"
              :aria-controls="'nav-dd-' + i"
              @click.stop="toggleMenu(item.title)"
            >
              <span>{{ item.title }}</span>
              <n-icon :name="openMenu === item.title ? 'arrow-up-01' : 'arrow-down-01'" size="16"></n-icon>
            </button>
            <a
              v-else
              class="nav-header__menu-link n-inline-flex n-align-center n-gap-xs n-color-neutral-800 n-text-md n-font-weight-medium n-text-decoration-none n-cursor-pointer"
              :class="{ 'is-current': activeTop === i }"
              :href="item.url"
              :aria-current="activeTop === i ? 'page' : undefined"
            >{{ item.title }}</a>

            <div
              v-if="item.children && openMenu === item.title"
              :id="'nav-dd-' + i"
              class="nav-header__dropdown n-position-absolute n-p-md n-shadow-md"
              :class="{ 'nav-header__dropdown--two-cols': item.twoColumns }"
              @click.stop
            >
              <a
                v-for="(child, j) in item.children"
                :key="child.title || j"
                class="n-block n-color-neutral-700 n-text-sm n-text-decoration-none"
                :href="child.url"
                :aria-current="activeTop === i && activeChild === j ? 'page' : undefined"
                @click="closeAll"
              >{{ child.title }}</a>
            </div>
          </li>
        </ul>
      </nav>

      <!-- Actions -->
      <div class="nav-header__actions n-flex n-align-center n-gap-xs">
        <!-- Search toggle (opens the search panel below the header) -->
        <button
          type="button"
          class="nav-header__icon-btn n-cursor-pointer n-radius-md"
          :aria-expanded="String(isSearchOpen)"
          aria-controls="nav-search-panel"
          :aria-label="t.search"
          :title="t.search"
          @click.stop="toggleSearch"
        >
          <i
            class="n-icon hgi-stroke n-color-inherit n-icon-size-20"
            :class="isSearchOpen ? 'hgi-cancel-01' : 'hgi-search-01'"
            aria-hidden="true"
          ></i>
        </button>

        <!-- Language -->
        <a
          id="LangLink"
          :href="switchLangUrl"
          :hreflang="isAr ? 'en' : 'ar'"
          :title="t.language"
          :aria-label="t.language + ' - ' + t.switchLabel"
          class="nav-header__lang n-color-neutral-800 n-btn n-btn--transparent n-btn--lg"
        >
          <i class="n-icon hgi-stroke hgi-globe-02 n-color-inherit n-icon-size-20" aria-hidden="true"></i>
          <span class="nav-header__lang-label">{{ t.switchLabel }}</span>
        </a>

        <!-- Najiz -->
        <a
          href="https://najiz.sa/applications/landing"
          target="_blank"
          rel="noopener"
          class="nav-header__najiz n-btn n-btn--primary n-btn--lg"
        >
          {{ t.najiz }}
          <i class="icon-link-square-02" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <!-- Search panel -->
    <div v-show="isSearchOpen" id="nav-search-panel" class="nav-search" @click.stop>
      <!-- No <form> here: SharePoint wraps the page in its own ASP.NET <form>,
           and a nested form is dropped by the browser, so submit would post back to home. -->
      <div class="nav-search__form n-flex n-align-center n-gap-xs" role="search">
        <label for="navSearchInput" class="sr-only">{{ t.search }}</label>
        <input
          id="navSearchInput"
          ref="searchInput"
          type="search"
          class="nav-search__input ds-text-input rounded"
          v-model="searchQuery"
          :placeholder="t.searchPlaceholder"
          autocomplete="off"
          enterkeyhint="search"
          @keydown.enter.prevent.stop="submitSearch"
        />
        <button
          type="button"
          class="nav-search__submit n-btn n-btn--primary n-btn--lg"
          :disabled="!searchQuery.trim()"
          @click.prevent.stop="submitSearch"
        >
          <i class="n-icon hgi-stroke hgi-search-01 n-icon-size-20" aria-hidden="true"></i>
          <span>{{ t.search }}</span>
        </button>
      </div>
    </div>
  </header>
</script>



<script type="module">
  import { setupNajizVueApp } from "/_catalogs/masterpage/MOJPortalDesign2026/dist/ce/vue-app.js";

  /* ---------- Server-side config (the only ASP.NET expressions outside the menu) ---------- */
  const IS_AR = false;

  /* ---------- Adjust these to your environment ---------- */
  // Search results page (same as the old jQuery handler); the query is appended URL-encoded.
  // The old script sent English pages to the Arabic results page too. If an English
  // results page exists, change the second value to "/english/search/Pages/SearchResults.aspx?sw=".
  const SEARCH_URL = IS_AR
    ? "/ar/search/Pages/SearchResults.aspx?sw="
    : "/english/search/Pages/SearchResults.aspx?sw=";
  // The results page reads the last query from sessionStorage under this key.
  const SEARCH_STORAGE_KEY = "searchVal";
  // true  = switching language keeps the user on the same page (/ar/... <-> /english/...)
  // false = always go to the other language's home page (old behaviour)
  const KEEP_PAGE_ON_LANG_SWITCH = true;
  const DESKTOP_QUERY = "(min-width: 58.8125rem)";

  const LABELS = {
    ar: {
      homeUrl: "/ar/",
      logoAlt: "شعار الوزارة",
      mainNav: "القائمة الرئيسية",
      openMenu: "فتح القائمة الرئيسية",
      closeMenu: "إغلاق القائمة الرئيسية",
      search: "بحث",
      searchPlaceholder: "أدخل نص البحث ....",
      language: "اللغة",
      switchLabel: "En",
      najiz: "منصة ناجز",
    },
    en: {
      homeUrl: "/english/",
      logoAlt: "Ministry logo",
      mainNav: "Main navigation",
      openMenu: "Open main menu",
      closeMenu: "Close main menu",
      search: "Search",
      searchPlaceholder: "Enter search text ....",
      language: "Language",
      switchLabel: "Ar",
      najiz: "Najiz Platform",
    },
  };

  /* ---------- Current-page matching for the menu highlight ---------- */
  // "/AR/MediaCenter/News/Pages/Default.aspx?x=1#y" -> "/ar/mediacenter/news/pages/default.aspx"
  // Links to other sites (najiz.sa, …) return "" so they are never highlighted.
  function normalizePath(url) {
    if (!url) return "";
    try {
      const u = new URL(url, window.location.origin);
      if (u.origin !== window.location.origin) return "";
      let path = decodeURIComponent(u.pathname).toLowerCase().replace(/\/+$/, "");
      if (!/\.aspx$/.test(path)) path += "/pages/default.aspx"; // "/ar/opendata" == its default page
      return path;
    } catch {
      return "";
    }
  }
  // The folder a link lives in, used to match the other pages of that section.
  // "/ar/mediacenter/news/pages/default.aspx" -> "/ar/mediacenter/news/"
  // Language roots ("/ar/", "/english/") are ignored, or every page would match the home link.
  function sectionFolder(path) {
    const folder = path.replace(/\/pages\/[^/]+\.aspx$/, "/").replace(/\/[^/]+\.aspx$/, "/");
    return folder.split("/").filter(Boolean).length >= 2 ? folder : "";
  }

  try {
    const app = await setupNajizVueApp({
      // Read the template from the x-template above (textContent = the raw, unparsed markup)
      template: document.getElementById("nav-header-tpl").textContent,
      data() {
        const t = IS_AR ? LABELS.ar : LABELS.en;
        return {
          isAr: IS_AR,
          t,
          isMobileMenuOpen: false,
          isSearchOpen: false,
          openMenu: null,
          searchQuery: "",
          // Absolute paths: an inline module's import.meta.url is the page URL, so keep these rooted at "/"
          logoUrl: "/_catalogs/masterpage/MOJPortalDesign2023/images/logo.webp",
          menuItems: [
            {
              title: 'About Ministry',
              twoColumns: true,
              children: [
                { title: 'About us', url: '/English/Ministry/pages/aboutus.aspx' },
                { title: 'MoJ’s History\r\n  ', url: '/English/Ministry/Pages/MOJHistory.aspx\r\n  ' },
                { title: 'Organizational Structure\r\n  ', url: '/English/Ministry/Pages/OrganizationalStructure.aspx\r\n  ' },
                { title: 'Leadership\r\n  ', url: '/English/Ministry/Pages/Leadership.aspx\r\n  ' },
                { title: 'Policies and Strategies\r\n  ', url: '/English/Ministry/Policies/Pages/default.aspx\r\n  ' },
                { title: 'Budget and Outlay\r\n  ', url: '/English/Ministry/Pages/Budget.aspx\r\n  ' },
                { title: 'Procurements\r\n  ', url: '/English/Ministry/Pages/Procurement.aspx\r\n  ' },
                { title: 'News and Events\r\n  ', url: '/English/Ministry/Pages/NewsAndEvents.aspx\r\n  ' },
                { title: 'Participation\r\n  ', url: '/english/Ministry/eParticipation/Pages/default.aspx\r\n  ' },
                { title: 'Contact Us\r\n  ', url: '/English/Ministry/Pages/ContactUs.aspx\r\n\r\n  ' },
                { title: 'We Care about You\r\n  ', url: '/English/Ministry/WeCare/Pages/default.aspx\r\n  ' },
                { title: 'Case Journey\r\n  ', url: '/english/Ministry/Pages/CaseTripInMOJ.aspx\r\n  ' },
                { title: 'Our Partners\r\n  ', url: '/English/Ministry/vision2030/Pages/OurPartners.aspx\r\n  ' },
                { title: 'MoJ’s Initiatives\r\n  ', url: '/English/Ministry/vision2030/Pages/Initiative.aspx\r\n  ' },
                { title: 'Sustainable Development', url: '/english/Ministry/SustainableDevelopment/Pages/default.aspx' },
                { title: 'Collaborative Training Program\r\n  ', url: 'https://training.moj.gov.sa/\r\n  ' },
                { title: 'Recruitment', url: '/english/Ministry/recruitment/Pages/default.aspx' },
                { title: 'Virtual Enforcement Court', url: '/English/Ministry/Pages/VirtualEnforcementCourt.aspx' },
                { title: 'e-Litigation', url: '/English/Ministry/Pages/eLitigation.aspx' },
                { title: 'Law Practice\r\n  ', url: '/english/Ministry/Departments/Mohammah/Pages/default.aspx\r\n  ' },
                { title: 'General Directorate of Private Notaries\r\n  ', url: '/english/Ministry/Departments/notaries/Pages/default.aspx\r\n  ' },
                { title: 'Marriage Registrars\r\n  ', url: '/English/Ministry/Departments/MarriageOfficial/Pages/default.aspx\r\n  ' },
                { title: 'Vision Realization Office\r\n  ', url: '/English/Ministry/vision2030/Pages/default.aspx\r\n  ' },
                { title: 'Najiz Judicial Services Center\r\n  ', url: '/english/Ministry/Departments/NajizCenter/Pages/default.aspx\r\n  ' },
                { title: 'Research Center\r\n  ', url: '/English/Ministry/Departments/ResearchCenter/Pages/default.aspx\r\n  ' },
                { title: 'Judicial Training Center\r\n  ', url: 'https://jtc.moj.gov.sa/\r\n  ' },
                { title: 'Data Management and Privacy Office\r\n  ', url: '/english/Ministry/Departments/DataAndPrivacyManagementOffice/Pages/default.aspx\r\n  ' },
                { title: 'Movable Properties for Sale\r\n  ', url: '/English/Ministry/Pages/TranscriptsList.aspx\r\n  ' },
                { title: 'Courts\r\n  ', url: '/English/Ministry/Courts/Pages/default.aspx\r\n  ' },
                { title: 'Notarial Offices\r\n  ', url: '/english/Ministry/Notary/Pages/default.aspx\r\n  ' },
              ],
            },
            {
              title: 'e-Services\r\n  ',
              children: [
                { title: 'Electronic Services Guide\r\n\r\n  ', url: '/english/eServices/Pages/default.aspx\r\n  ' },
                { title: 'Electronic Services Platform (Najiz)\r\n\r\n  ', url: 'https://najiz.sa/applications/landing\r\n  ' },
                { title: 'Taradhi Platform\r\n  ', url: 'https://taradhi.moj.gov.sa/\r\n  ' },
              ],
            },
            {
              title: 'Participation\r\n  ',
              url: '/english/Ministry/eParticipation/Pages/default.aspx\r\n  ',
            },
            {
              title: 'Laws \u0026 Circulars\r\n  ',
              children: [
                { title: 'Laws\r\n  ', url: 'https://laws.moj.gov.sa/?lang=en\r\n    ' },
                { title: 'Circulars\r\n  ', url: 'https://www.moj.gov.sa/TameemPortal/Pages/default.aspx\r\n    ' },
              ],
            },
            {
              title: 'Open Data\r\n  ',
              url: '/English/opendata/Pages/reports.aspx\r\n  ',
            },
            {
              title: 'Media Center\r\n  ',
              children: [
                { title: 'MoJ News\r\n  ', url: '/English/MediaCenter/news/Pages/default.aspx\r\n  ' },
                { title: 'Moon-Sighting Panel Decisions\r\n  ', url: '/English/MediaCenter/News/Pages/SupremeCourtNews.aspx\r\n  ' },
                { title: 'Events Calendar\r\n  ', url: '/English/MediaCenter/Pages/MOJ-Events.aspx\r\n\t' },
                { title: 'Announcements\r\n  ', url: '/English/MediaCenter/Announcements/Pages/default.aspx\r\n  ' },
                { title: 'Publications\r\n  ', url: '/english/MediaCenter/Pages/Versions.aspx\r\n  ' },
              ],
            },
          ],
        };
      },

      computed: {
        /* Which menu entry matches the page you are on.
           1) exact page match wins; 2) otherwise the link whose folder is the longest
              prefix of the current address (e.g. NewsDetails.aspx -> "أخبار الوزارة"). */
        activeMatch() {
          const here = normalizePath(window.location.href);
          if (!here) return null;
          let best = null;
          const consider = (url, top, child) => {
            const target = normalizePath(url);
            if (!target) return;
            let score = 0;
            if (target === here) score = 10000 + target.length;
            else {
              const folder = sectionFolder(target);
              if (folder && here.startsWith(folder)) score = folder.length;
            }
            // A top-level link (e.g. المشاركة الإلكترونية) beats a dropdown child with the same URL
            if (score && child === null) score += 0.5;
            if (score && (!best || score > best.score)) best = { score, top, child };
          };
          this.menuItems.forEach((item, i) => {
            if (item.url) consider(item.url, i, null);
            (item.children || []).forEach((child, j) => consider(child.url, i, j));
          });
          return best;
        },
        activeTop() {
          return this.activeMatch ? this.activeMatch.top : -1;
        },
        activeChild() {
          return this.activeMatch ? this.activeMatch.child : null;
        },
        switchLangUrl() {
          const fallback = IS_AR ? "/english/pages/default.aspx" : "/ar/pages/default.aspx";
          if (!KEEP_PAGE_ON_LANG_SWITCH) return fallback;
          const { pathname, search, hash } = window.location;
          const from = IS_AR ? /\/ar\//i : /\/english\//i;
          const to = IS_AR ? "/english/" : "/ar/";
          return from.test(pathname) ? pathname.replace(from, to) + search + hash : fallback;
        },
      },

      mounted() {
        document.addEventListener("click", this.closeAll);
        document.addEventListener("keydown", this.onKeydown);
        this.mq = window.matchMedia(DESKTOP_QUERY);
        this.mq.addEventListener("change", this.onBreakpointChange);
      },

      beforeUnmount() {
        document.removeEventListener("click", this.closeAll);
        document.removeEventListener("keydown", this.onKeydown);
        this.mq?.removeEventListener("change", this.onBreakpointChange);
      },

      methods: {
        toggleMobileMenu() {
          this.isMobileMenuOpen = !this.isMobileMenuOpen;
          this.isSearchOpen = false;
        },
        toggleMenu(title) {
          this.openMenu = this.openMenu === title ? null : title;
          this.isSearchOpen = false;
        },
        toggleSearch() {
          const open = !this.isSearchOpen;
          this.closeAll();
          this.isMobileMenuOpen = false;
          this.isSearchOpen = open;
          if (open) this.$nextTick(() => this.$refs.searchInput?.focus());
        },
        closeAll() {
          this.openMenu = null;
          this.isSearchOpen = false;
        },
        onKeydown(e) {
          if (e.key !== "Escape") return;
          this.closeAll();
          this.isMobileMenuOpen = false;
        },
        onBreakpointChange(e) {
          if (e.matches) this.isMobileMenuOpen = false;
        },
        submitSearch() {
          const query = (this.searchQuery || "").trim();
          if (!query) return;
          const encoded = encodeURIComponent(query);
          try {
            sessionStorage.setItem(SEARCH_STORAGE_KEY, encoded);
          } catch {
            /* storage unavailable – the results page still gets ?sw= */
          }
          window.location.href = SEARCH_URL + encoded;
        },
      },
    });

    app.mount("#nav-header-root");
  } catch (error) {
    console.error("[nav-header]", error);
    document.getElementById("nav-header-root").textContent =
      IS_AR ? "تعذر تحميل هذا القسم" : "This section could not be loaded";
  }
</script>

