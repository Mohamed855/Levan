<script type="text/javascript">
  (function () {
    var loaded = false;
    var events = ["scroll", "touchstart", "keydown", "click"];

    function loadHudhud() {
      if (loaded) return;
      loaded = true;
      events.forEach(function (e) { window.removeEventListener(e, loadHudhud); });

      var s = document.createElement("script");
      s.type = "module";
      s.src = "https://hudhud.services/get_hudhud_widget/6fbcee03-769a-4245-9088-a0370594204b";
      s.referrerPolicy = "no-referrer-when-downgrade";
      document.body.appendChild(s);
    }

    events.forEach(function (e) {
      window.addEventListener(e, loadHudhud, { once: true, passive: true });
    });
  })();
</script>



</body>

